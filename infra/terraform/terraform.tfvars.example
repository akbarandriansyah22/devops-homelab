aws_region       = "ap-southeast-1"
vpc_cidr         = "10.42.0.0/16"
instance_type    = "t3.micro"
ssh_cidr         = "YOUR_PUBLIC_IP/32"
allowed_app_cidr = "YOUR_PUBLIC_IP/32"
key_name         = "your-existing-keypair"
ghcr_image       = "ghcr.io/akbarandriansyah22/devops-homelab/ecommerce-api:latest"
environment      = "staging"

